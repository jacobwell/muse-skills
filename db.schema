  run_id                         String
  contract_fingerprint           String
  created_at                     DateTime
  @@id([launch_occurrence_agent_id, launch_occurrence_message_id, launch_occurrence_tool_call_id])
  runtime_workflow_runs          runtime_workflow_runs  @relation(fields: [run_id], references: [run_id])
  @@schema("runtime")
  @@map("workflow_launch_occurrence_aliases")
}

model runtime_workflow_legacy_launch_occurrence_blocks {
  launch_occurrence_agent_id     String
  launch_occurrence_message_id   String
  launch_occurrence_tool_call_id String
  legacy_run_id                  String
  reason                         String
  created_at                     DateTime
  @@id([launch_occurrence_agent_id, launch_occurrence_message_id, launch_occurrence_tool_call_id])
