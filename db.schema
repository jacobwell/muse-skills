model runtime_workflow_runs {
  run_id                                String                       @id
  root_agent_id                         String
  parent_message_id                     String?
  launching_agent_id                    String?
  launching_message_id                  String?
  launching_tool_call_id                String?
  task_id                               String
  resume_from_run_id                    String?
  workflow_name                         String
  description                           String
  phases_json                           Json
  args_json                             Json?
  workspace_root                        String
  script_path                           String
  script_sha256                         String
  request_trace_json                    Json?
  executor_id                           String?
  execution_attempt                     Int
  heartbeat_at                          DateTime
  lease_expires_at                      DateTime?
  recovery_count                        Int
  last_recovery_reason                  String?
  last_recovered_at                     DateTime?
  status                                String
  error                                 String?
  final_result                          String?
  created_at                            DateTime
  started_at                            DateTime?
  updated_at                            DateTime
  completed_at                          DateTime?
  launch_mode                           String
  terminal_handoff_channel              String?
  terminal_handoff_delivery_target      String?
  terminal_handoff_channel_context_json Json?
  terminal_handoff_message_id           String?
  terminal_handoff_delivered_at         DateTime?
  terminal_handoff_attempt_count        Int
  terminal_handoff_last_attempt_at      DateTime?
  terminal_handoff_next_attempt_at      DateTime?
  terminal_handoff_last_error           String?
  launch_occurrence_agent_id            String?
  launch_occurrence_message_id          String?
  launch_occurrence_tool_call_id        String?
  sync_wait_deadline_at                 DateTime?
  terminal_handoff_disposition          String?
  terminal_handoff_generation           Int
  magi_workload_class                   String?
  runtime_workflow_runs                 runtime_workflow_runs?  @relation(fields: [resume_from_run_id], references: [run_id])
  runtime_workflow_agent_calls          runtime_workflow_agent_calls[]
  runtime_workflow_launch_occurrence_aliases runtime_workflow_launch_occurrence_aliases[]
  runtime_workflow_legacy_launch_occurrence_blocks runtime_workflow_legacy_launch_occurrence_blocks[]
  runtime_workflow_phase_runs           runtime_workflow_phase_runs[]
  runtime_workflow_runs                 runtime_workflow_runs[]
  @@schema("runtime")
  @@map("workflow_runs")
}

