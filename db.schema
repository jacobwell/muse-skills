// Muse application database — Prisma schema format
// Generated 2026-09-25 from the muse.db schema reference.
// Read-only query surface: credentials, catalogs, migration/backup tables,
// Sentinel approvals, per-artifact DBs, and private model reasoning are excluded.
// Custom enum types map to String; fill values from the live DB if needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["activity", "agent", "device", "feed", "goals", "health", "ideas", "ingest", "media", "memory", "messages", "podcasts", "runtime", "scheduler", "self_improvement", "shell", "spaces"]
}

model activity_activity_monitor_agent_threads {
  agent_id           String                       @id
  activity_thread_id String
  created_at         String
  updated_at         String
  @@schema("activity")
  @@map("activity_monitor_agent_threads")
}

model activity_activity_monitor_carrier_user_messages {
  link_seq           BigInt                       @id
  carrier_message_id String
  user_message_id    String
  root_agent_id      String?
  created_at         DateTime
  @@schema("activity")
  @@map("activity_monitor_carrier_user_messages")
}

model activity_activity_monitor_message_threads {
  message_id         String                       @id
  activity_thread_id String
  created_at         String
  updated_at         String
  @@schema("activity")
  @@map("activity_monitor_message_threads")
}

model activity_activity_monitor_runtime_work_threads {
  work_id            String                       @id
  activity_thread_id String
  created_at         String
  updated_at         String
  activity_activity_monitor_threads activity_activity_monitor_threads  @relation(fields: [activity_thread_id], references: [activity_thread_id])
  @@schema("activity")
  @@map("activity_monitor_runtime_work_threads")
}

model activity_activity_monitor_thread_actions {
  action_seq         BigInt
  action_id          String                       @id
  activity_thread_id String
  action_index       BigInt
  agent_id           String?
  agent_depth        Int?
  icon               String
  title              String
  subtitle           String?
  report             String
  status             String
  created_at         String
  section_key        String?
  section_title      String?
  section_order      Int?
  section_depth      Int?
  parent_section_key String?
  ordinal_label      String?
  @@schema("activity")
  @@map("activity_monitor_thread_actions")
}

model activity_activity_monitor_thread_sections {
  activity_thread_id String
  section_key        String
  title              String
  status             String
  section_order      Int?
  section_depth      Int?
  parent_section_key String?
  ordinal_label      String?
  created_at         String
  updated_at         String
  @@id([activity_thread_id, section_key])
  activity_activity_monitor_threads activity_activity_monitor_threads  @relation(fields: [activity_thread_id], references: [activity_thread_id])
  @@schema("activity")
  @@map("activity_monitor_thread_sections")
}

model activity_activity_monitor_threads {
  activity_thread_id          String                       @id
  name                        String
  subtitle                    String
  status_title                String?
  icon                        String
  emoji                       String?
  activity_thread_kind        String?
  space_slug                  String?
  expected_finish_description String?
  status                      String
  finish_status               String?
  finish_status_reason        String?
  created_at                  String
  finished_at                 String?
  finish_message              String?
  artifact_slug               String?
  activity_activity_monitor_runtime_work_threads activity_activity_monitor_runtime_work_threads[]
  activity_activity_monitor_thread_sections activity_activity_monitor_thread_sections[]
  @@schema("activity")
  @@map("activity_monitor_threads")
}

model activity_feed_entries {
  activity_key   String                       @id
  activity_type  String
  is_goal        Boolean
  message_id     String?
  title          String?
  status_title   String?
  subtitle       String?
  details_json   String?
  status         String
  task_label     String?
  created_at_ms  BigInt
  updated_at_ms  BigInt
  finished_at_ms BigInt?
  created_at     DateTime?
  updated_at     DateTime?
  finished_at    DateTime?
  @@schema("activity")
  @@map("feed_entries")
}

model agent_agent_ancestors {
  descendant_id String
  ancestor_id   String
  distance      Int
  @@id([descendant_id, ancestor_id])
  @@schema("agent")
  @@map("agent_ancestors")
}

model agent_agent_compactions {
  id                      BigInt                       @id
  agent_id                String
  summary                 String
  first_kept_seq          BigInt?
  checkpoint_seq          BigInt?
  tokens_before           BigInt?
  tokens_after            BigInt?
  trigger                 String
  will_retry              Boolean
  created_at              BigInt
  has_replacement_history Boolean
  @@schema("agent")
  @@map("agent_compactions")
}

model agent_agent_message_token_usage {
  agent_id      String
  message_id    String
  input_tokens  BigInt
  output_tokens BigInt
  created_at    BigInt
  @@id([agent_id, message_id])
  @@schema("agent")
  @@map("agent_message_token_usage")
}

model agent_agents {
  agent_id                          String                       @id
  id                                String?
  session_id                        String?
  kind                              String
  parent_id                         String?
  parent_agent_id                   String?
  root_session_id                   String?
  request_id                        String?
  model                             String
  status                            String
  depth                             Int
  created_at                        BigInt
  updated_at                        BigInt
  last_assistant_message            String?
  seen_at_ms                        BigInt?
  prompt_floor_seq                  BigInt?
  ephemeral                         Boolean
  last_assistant_resources          String?
  agent_type                        String?
  presentation_root_session_id      String?
  spawn_metadata_json               String?
  originating_location_context_json String?
  runtime_requests                  runtime_requests?  @relation(fields: [request_id], references: [request_id])
  agent_message_mailbox             agent_message_mailbox[]
  agent_session_memory_capture_deadlines agent_session_memory_capture_deadlines[]
  @@schema("agent")
  @@map("agents")
}

model agent_chat_preferences {
  id                        Int                          @id
  active_root_id            String
  verbose                   BigInt
  usage_mode                String
  active_root_cleared_at_ms BigInt?
  @@schema("agent")
  @@map("chat_preferences")
}

model agent_compactions {
  compaction_id                 BigInt                       @id
  agent_id                      String
  checkpoint_context_item_id    BigInt?
  replacement_history_first_seq Int?
  replacement_history_last_seq  Int?
  created_at                    DateTime
  summary_text                  String
  agent_context_items           agent_context_items?  @relation(fields: [checkpoint_context_item_id], references: [context_item_id])
  @@schema("agent")
  @@map("compactions")
}

model agent_context_item_derived_write_backlog {
  context_item_id BigInt                       @id
  attempts        Int
  last_error      String?
  created_at      DateTime
  updated_at      DateTime
  deadlettered_at DateTime?
  agent_context_items agent_context_items  @relation(fields: [context_item_id], references: [context_item_id])
  @@schema("agent")
  @@map("context_item_derived_write_backlog")
}

model agent_context_item_fields {
  context_item_field_id BigInt                       @id
  context_item_id       BigInt
  field_path            String
  scalar_type           String
  scalar_value          String?
  field_text_content    String?
  agent_context_items   agent_context_items  @relation(fields: [context_item_id], references: [context_item_id])
  @@schema("agent")
  @@map("context_item_fields")
}

model agent_context_item_resume_projection {
  agent_id                 String
  seq                      BigInt
  context_item_id          BigInt?
  created_at               BigInt?
  message_source           String?
  client_context_json      String?
  reply_prefix             String?
  provenance_json          String?
  client_context_projected Boolean
  reply_prefix_projected   Boolean
  provenance_projected     Boolean
  updated_at               DateTime
  @@id([agent_id, seq])
  agent_context_items      agent_context_items?  @relation(fields: [context_item_id], references: [context_item_id])
  @@schema("agent")
  @@map("context_item_resume_projection")
}

model agent_context_items {
  context_item_id         BigInt                       @id
  agent_id                String
  seq                     BigInt
  item_kind               String  // custom enum agent.context_item_kind; values not in reference
  message_id              String?
  tool_call_id            BigInt?
  tool_output_id          BigInt?
  role                    String?  // custom enum runtime.message_role; values not in reference
  call_id                 String?
  tool_name               String?
  success                 Boolean?
  message_source          String?
  created_at              DateTime
  data_fbids              BigInt[]?
  data_message_ids        String[]?
  data_cleanup_checked_at DateTime?
  data_summarized_at      DateTime?
  data_thread_ids         String[]?
  data_expires_at         DateTime?
  text_content            String?
  item_json               String?
  runtime_messages        runtime_messages?  @relation(fields: [message_id], references: [message_id])
  runtime_tool_calls      runtime_tool_calls?  @relation(fields: [tool_call_id], references: [tool_call_id])
  runtime_tool_outputs    runtime_tool_outputs?  @relation(fields: [tool_output_id], references: [tool_output_id])
  agent_compactions       agent_compactions[]
  agent_context_item_derived_write_backlog agent_context_item_derived_write_backlog[]
  agent_context_item_fields agent_context_item_fields[]
  agent_context_item_resume_projection agent_context_item_resume_projection[]
  agent_context_text_segments agent_context_text_segments[]
  @@schema("agent")
  @@map("context_items")
}

model agent_context_text_segments {
  context_text_segment_id BigInt                       @id
  context_item_id         BigInt
  ordinal                 Int
  text_content            String
  agent_context_items     agent_context_items  @relation(fields: [context_item_id], references: [context_item_id])
  @@schema("agent")
  @@map("context_text_segments")
}

model agent_message_mailbox {
  submission_id           String                       @id
  accepted_ordinal        BigInt
  agent_id                String
  conversation_epoch      BigInt
  submission_kind         String
  routing_scope           String
  state                   String
  stream_owner_message_id String?
  submission_json         String
  transcript_event_seq    BigInt?
  accepted_at             DateTime
  attached_at             DateTime?
  terminalized_at         DateTime?
  checkpoint_custody      String?
  agent_agents            agent_agents  @relation(fields: [agent_id], references: [agent_id])
  runtime_events          runtime_events?  @relation(fields: [transcript_event_seq], references: [event_seq])
  @@schema("agent")
  @@map("message_mailbox")
}

model agent_recovery_owner_terminal_events {
  recovery_class String
  owner_id       String
  generation     BigInt
  event_type     String
  claimed_at     DateTime
  @@id([recovery_class, owner_id, generation, event_type])
  @@schema("agent")
  @@map("recovery_owner_terminal_events")
}

model agent_recovery_owners {
  recovery_class  String
  owner_id        String
  generation      BigInt
  agent_id        String
  message_id      String
  active_at       DateTime
  terminal_at     DateTime?
  terminal_status String?
  @@id([recovery_class, owner_id])
  @@schema("agent")
  @@map("recovery_owners")
}

model agent_runtime_restart_checkpoints {
  agent_id              String                       @id
  mode                  String
  payload_json          String?
  created_at            BigInt
  updated_at            BigInt
  recovery_class        String?
  recovery_owner_id     String?
  execution_config_json String?
  @@schema("agent")
  @@map("runtime_restart_checkpoints")
}

model agent_runtime_state {
  agent_id            String                       @id
  current_context_seq Int
  last_event_seq      BigInt?
  updated_at          DateTime
  runtime_events      runtime_events?  @relation(fields: [last_event_seq], references: [event_seq])
  @@schema("agent")
  @@map("runtime_state")
}

model agent_session_memory_capture_deadlines {
  root_session_id String                       @id
  session_id      String?
  reason          String
  due_at_ms       BigInt
  created_at_ms   BigInt
  updated_at_ms   BigInt
  agent_agents    agent_agents  @relation(fields: [root_session_id], references: [agent_id])
  @@schema("agent")
  @@map("session_memory_capture_deadlines")
}

model agent_session_metadata {
  session_id                    String                       @id
  origin                        String
  lifecycle                     String
  status                        String
  thread_title                  String?
  source_session_id             String?
  source_prompt_seq_upper_bound BigInt?
  source_message_id_boundary    String?
  created_at                    BigInt
  updated_at                    BigInt
  pinned                        Boolean
  channel                       String?
  channel_conversation_id       String?
  channel_delivery_target       String?
  pinned_order                  BigInt?
  @@schema("agent")
  @@map("session_metadata")
}

model agent_sessions {
  session_id      String                       @id
  root_request_id String?
  created_at      DateTime
  updated_at      DateTime
  archived_at     DateTime?
  runtime_requests runtime_requests?  @relation(fields: [root_request_id], references: [request_id])
  @@schema("agent")
  @@map("sessions")
}

model agent_subagent_monitor_decisions {
  decision_id          BigInt                       @id
  coordinator_agent_id String
  child_agent_id       String
  parent_agent_id      String
  parent_message_id    String
  monitor_event_id     BigInt
  monitor_event_kind   String
  inference_request_id String
  assistant_text       String?
  tool_call_id         String?
  tool_name            String?
  tool_arguments       String?
  tool_result_json     String
  decision_kind        String
  created_at           BigInt
  @@schema("agent")
  @@map("subagent_monitor_decisions")
}

model agent_subagent_progress {
  progress_id    BigInt                       @id
  child_agent_id String
  event_seq      BigInt?
  status         String
  created_at     DateTime
  progress_text  String?
  runtime_events runtime_events?  @relation(fields: [event_seq], references: [event_seq])
  @@schema("agent")
  @@map("subagent_progress")
}

model agent_subagent_progress_message_events {
  event_id          BigInt                       @id
  child_agent_id    String
  parent_agent_id   String
  parent_message_id String
  message_text      String
  created_at        BigInt
  delivered_at      BigInt?
  @@schema("agent")
  @@map("subagent_progress_message_events")
}

model agent_subagent_progress_tool_events {
  event_id            BigInt                       @id
  child_agent_id      String
  parent_agent_id     String
  parent_message_id   String
  tool_name           String
  tool_description    String
  tool_status         String
  tool_result_preview String?
  created_at          BigInt
  delivered_at        BigInt?
  run_id              String?
  @@schema("agent")
  @@map("subagent_progress_tool_events")
}

model agent_subagent_spawns {
  spawn_id                       BigInt                       @id
  parent_agent_id                String
  child_agent_id                 String
  parent_message_id              String?
  parent_request_id              String?
  root_request_id                String?
  root_message_execution_id      String?
  request_id                     String?
  created_at                     BigInt
  status                         String?
  deferred_terminal_status       String?
  final_response                 String?
  completed_at                   BigInt?
  prompt                         String?
  requester_source               String?
  requester_channel_context_json String?
  seen_at                        BigInt?
  child_depth                    Int
  agent_type                     String?
  metadata_json                  String?
  spawn_call_id                  String?
  runtime_requests               runtime_requests?  @relation(fields: [request_id], references: [request_id])
  @@schema("agent")
  @@map("subagent_spawns")
}

model agent_token_usage {
  token_usage_id      BigInt                       @id
  agent_id            String
  request_id          String?
  input_tokens        Int
  output_tokens       Int
  cached_input_tokens Int
  reasoning_tokens    Int
  created_at          DateTime
  runtime_requests    runtime_requests?  @relation(fields: [request_id], references: [request_id])
  @@schema("agent")
  @@map("token_usage")
}

model agent_volatile_context_pins {
  agent_id         String
  variant_hash     String
  variant_json     String
  prompt_floor_seq BigInt
  checkpoint_seq   BigInt
  body             String?
  created_at       DateTime
  @@id([agent_id, variant_hash])
  @@schema("agent")
  @@map("volatile_context_pins")
}

model device_calendar_events {
  node_id              String
  external_event_id    String
  title                String
  start_at             DateTime
  end_at               DateTime
  is_all_day           Boolean
  external_calendar_id String
  calendar_name        String
  availability         String
  location             String?
  notes                String?
  time_zone            String?
  start_local_date     DateTime?
  end_local_date       DateTime?
  is_recurring         Boolean
  url                  String?
  event_status         String
  calendar_color       String?
  @@id([node_id, external_event_id])
  device_nodes         device_nodes  @relation(fields: [node_id], references: [node_id])
  @@schema("device")
  @@map("calendar_events")
}

model device_call_log {
  call_log_id         BigInt                       @id
  producer_id         String
  external_id         String
  phone_number        String?
  contact_name        String?
  call_type           String?
  occurred_at_unix_ms BigInt?
  duration_seconds    BigInt?
  platform            String?
  created_at          DateTime
  @@schema("device")
  @@map("call_log")
}

model device_client_contexts {
  connection_id     String                       @id
  device_id         String
  session_id        String?
  root_session_id   String?
  platform          String?
  view              String?
  mode              String?
  is_visible        Boolean?
  presence_status   String
  metadata_json     Json?
  connected_at_ms   BigInt
  last_active_at_ms BigInt
  updated_at_ms     BigInt
  created_at        DateTime
  @@schema("device")
  @@map("client_contexts")
}

model device_contact_addresses {
  contact_address_id BigInt                       @id
  contact_id         BigInt
  label              String?
  street             String?
  city               String?
  state              String?
  postal_code        String?
  country            String?
  device_contacts    device_contacts  @relation(fields: [contact_id], references: [contact_id])
  @@schema("device")
  @@map("contact_addresses")
}

model device_contact_emails {
  contact_email_id BigInt                       @id
  contact_id       BigInt
  label            String?
  email            String
  device_contacts  device_contacts  @relation(fields: [contact_id], references: [contact_id])
  @@schema("device")
  @@map("contact_emails")
}

model device_contact_phones {
  contact_phone_id BigInt                       @id
  contact_id       BigInt
  label            String?
  phone_e164       String?
  phone_raw        String
  device_contacts  device_contacts  @relation(fields: [contact_id], references: [contact_id])
  @@schema("device")
  @@map("contact_phones")
}

model device_contacts {
  contact_id          BigInt                       @id
  node_id             String
  platform            String
  external_contact_id String
  display_name        String?
  given_name          String?
  family_name         String?
  organization        String?
  job_title           String?
  birthday_text       String?
  note                String?
  synced_at_text      String
  deleted_at          DateTime?
  updated_at          DateTime
  thumbnail           String?
  device_nodes        device_nodes  @relation(fields: [node_id], references: [node_id])
  device_contact_addresses device_contact_addresses[]
  device_contact_emails device_contact_emails[]
  device_contact_phones device_contact_phones[]
  @@schema("device")
  @@map("contacts")
}

model device_data_sync_state {
  node_id                                         String
  data_source                                     String
  next_full_sync_at                               DateTime?
  current_full_sync_id                            String?
  current_full_sync_expires_at                    DateTime?
  current_full_sync_range_start                   DateTime?
  current_full_sync_range_end                     DateTime?
  changed_during_full_sync                        Boolean
  last_full_sync_at                               DateTime?
  last_full_sync_range_start                      DateTime?
  last_full_sync_range_end                        DateTime?
  search_trigger_pending                          Boolean
  current_full_sync_requester_root_session_id     String?
  current_full_sync_requester_presentation_locale String?
  @@id([node_id, data_source])
  device_nodes                                    device_nodes  @relation(fields: [node_id], references: [node_id])
  @@schema("device")
  @@map("data_sync_state")
}

model device_media_upload_batches {
  lane                       String                       @id
  batch_id                   String
  high_water_global_seq      BigInt
  pending_count              BigInt
  oldest_received_at_unix_ms BigInt
  claimed_at                 DateTime
  @@schema("device")
  @@map("media_upload_batches")
}

model device_media_upload_events {
  media_upload_event_id BigInt                       @id
  global_seq            BigInt
  event_id              String
  media_id              String
  node_id               String?
  lane                  String
  received_at_text      String
  received_at_unix_ms   BigInt
  received_at           DateTime
  status                String
  processed_at_text     String?
  processed_at_unix_ms  BigInt?
  processed_at          DateTime?
  handoff_message_id    String?
  summary_preview       String?
  failure_code          String?
  failure_message       String?
  device_nodes          device_nodes?  @relation(fields: [node_id], references: [node_id])
  @@schema("device")
  @@map("media_upload_events")
}

model device_nodes {
  node_id                   String                       @id
  node_kind                 String
  display_name              String?
  platform                  String
  enabled_permissions_json  String
  commands_json             String
  version                   String?
  device_family             String?
  model_id                  String?
  is_wakeup_supported       Boolean?
  delivery_app              String?
  paired_at_text            String?
  created_at                DateTime
  last_seen_at_text         String?
  last_seen_at              DateTime?
  status                    String
  revoked                   Boolean
  contacts_last_synced_at   String?
  contacts_last_received_at String?
  contacts_last_sync_status String
  contacts_last_sync_error  String?
  contacts_contact_count    BigInt
  health_last_received_at   String?
  health_last_sync_status   String
  health_last_sync_error    String?
  data_sources_json         String
  invoke_protocol           String
  pairing_status            String
  contacts_content_sha256   String?
  metadata_json             String
  location_sharing_mode     String?
  device_calendar_events    device_calendar_events[]
  device_contacts           device_contacts[]
  device_data_sync_state    device_data_sync_state[]
  device_media_upload_events device_media_upload_events[]
  @@schema("device")
  @@map("nodes")
}

model device_upload_chunks {
  upload_session_id String
  chunk_index       Int
  payload_digest    String
  created_at_text   String
  created_at        DateTime
  payload           String
  @@id([upload_session_id, chunk_index])
  device_upload_sessions device_upload_sessions  @relation(fields: [upload_session_id], references: [upload_session_id])
  @@schema("device")
  @@map("upload_chunks")
}

model device_upload_sessions {
  upload_session_id String                       @id
  node_id           String
  route_kind        String
  request_id        String?
  datatype          String
  sync_mode         String?
  chunk_count       Int
  status            String
  created_at_text   String
  updated_at_text   String
  expires_at_text   String
  expires_at        DateTime
  created_at        DateTime
  response          String?
  device_upload_chunks device_upload_chunks[]
  @@schema("device")
  @@map("upload_sessions")
}

model feed_fleet_engagement_contributions {
  contribution_id    String                       @id
  origin_id          String
  engagement_version BigInt
  created_at_ms      BigInt
  updated_at_ms      BigInt
  @@schema("feed")
  @@map("fleet_engagement_contributions")
}

model feed_fleet_engagement_outbox {
  contribution_id    String                       @id
  origin_id          String
  deleted_count      BigInt
  discuss_count      BigInt
  share_count        BigInt
  seed_use_count     BigInt
  mutation_version   BigInt
  attempt_count      Int
  next_attempt_at_ms BigInt
  created_at_ms      BigInt
  updated_at_ms      BigInt
  @@schema("feed")
  @@map("fleet_engagement_outbox")
}

model feed_fleet_fetch_receipts {
  payload_hash        String                       @id
  first_fetched_at_ms BigInt
  origin_id           String?
  @@schema("feed")
  @@map("fleet_fetch_receipts")
}

model feed_fleet_publish_state {
  singleton              Boolean                      @id
  published_watermark_ms BigInt
  @@schema("feed")
  @@map("fleet_publish_state")
}

model feed_fleet_reaction_outbox {
  unit_id            String                       @id
  origin_id          String
  liked              Boolean
